From 4413f8b045a88aa47dbbeeedcb4411c7c2b0f989 Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Sun, 8 Nov 2026 14:36:21 -0600
Subject: [PATCH 4/5] Controller: check at startup that bitcoind serves
 transactions by block hash

The startup check asked for tx #1 with getrawtransaction and no block
hash, and on failure told the user to enable -txindex. With
blockchain.transaction.get now naming the block, -txindex is not needed,
and a pruned node cannot enable it anyway.

Ask the way transaction.get now asks: tx #1 with the hash of its block,
taken from our own headers (BTC::HeaderHashRev). Block 1 is long gone
from a pruned node, so this exercises the pruned path end to end. On
failure, say what is actually needed: btc-rpc-proxy v0.8.0 or later on a
pruned node's RPC port. An archival node answers it with or without
-txindex.

Three failures and it stops asking until restart, rather than a fetch
from peers and the banner on every block.
---
 src/Controller.cpp | 40 ++++++++++++++++++++++++++++------------
 1 file changed, 28 insertions(+), 12 deletions(-)

diff --git a/src/Controller.cpp b/src/Controller.cpp
index ebf75d8..6e9520e 100644
--- a/src/Controller.cpp
+++ b/src/Controller.cpp
@@ -213,14 +213,21 @@ void Controller::startup()
         }
     }, Qt::QueuedConnection);
 
-    // Checks if the remote bitcoind has -txindex or can serve arbitrary transactions. Called initially when upToDate()
-    // is first emitted, and disconnects itself from upToDate if we did in fact detect that bitcoind can serve arbitrary
-    // tx's. If there is an error retrieving tx #1, it will warn the user to enable txindex.
-    // Assumption: tx #1 is not a bitcoind wallet tx. (If it is, then we will get a possible false positive here).
+    // Checks that the remote bitcoind can serve a confirmed transaction the way blockchain.transaction.get asks for
+    // one: with the hash of the block holding it, taken from our own index. That needs no -txindex, and on a pruned
+    // node it goes through btc-rpc-proxy, which fetches the block from peers. Asks for tx #1 (in block 1, which a
+    // pruned node has discarded), so a node whose RPC cannot serve pruned blocks is caught here, at startup, rather
+    // than by the first wallet that looks a transaction up. Called initially when upToDate() is first emitted, and
+    // disconnects itself from upToDate once it succeeds.
     auto connPtr2 = std::make_shared<QMetaObject::Connection>();
-    *connPtr2 = connect(this, &Controller::upToDate, this, [this, connPtr2] {
+    auto failures = std::make_shared<int>(0);
+    *connPtr2 = connect(this, &Controller::upToDate, this, [this, connPtr2, failures] {
         const auto optHash = storage->hashForTxNum(1, false, nullptr, true); // skip cache, read from txNum2txHash file to get first non-genesis tx hash
         if (!optHash) return; // no blocks yet, somehow. must be a brand new chain. we will be called again later when blocks start showing up.
+        const auto optHeight = storage->heightForTxNum(1);
+        const auto optHeader = optHeight ? storage->headerForHeight(*optHeight) : std::nullopt;
+        if (!optHeader) return; // not expected once tx #1 is indexed; try again on the next upToDate()
+        const QByteArray blockHashHex = Util::ToHexFast(BTC::HeaderHashRev(*optHeader));
         auto onSuccess = [this, connPtr2, hash=*optHash] (const RPC::Message &resp) {
             bitcoin::CMutableTransaction tx;
             constexpr auto kErrLine2 = "Something is wrong with either BitcoinD or our ability to understand its RPC responses.";
@@ -236,23 +243,32 @@ void Controller::startup()
                 Error() << kErrLine2;
                 return;
             }
-            DebugM("BitcoinD verified to have txindex enabled");
+            DebugM("BitcoinD verified to serve indexed transactions by block hash");
             // success! disconnect the slot now, connPtr2 will delete the managed object when we return.
             disconnect(*connPtr2);
         };
-        auto onError = [] (const RPC::Message &resp) {
+        // Asked again at each upToDate (each new block) until it succeeds, but not forever: on a node that cannot serve
+        // it, that is a fetch from peers and this banner on every block. Three tries, then the banner says so and stops.
+        auto onError = [this, connPtr2, failures] (const RPC::Message &resp) {
             Error() << "\n"
                     << "******************************************************************************\n"
-                    << "*   Error: txindex verification failed!                                      *\n"
-                    << "*   Please ensure that your BitcoinD node has txindex enabled (-txindex=1)   *\n"
+                    << "*   Error: BitcoinD could not serve transaction #1 by its block hash!        *\n"
+                    << "*   Wallets will not be able to look up confirmed transactions.              *\n"
+                    << "*   On a pruned node, the RPC port must be served by btc-rpc-proxy v0.8.0    *\n"
+                    << "*   or later (v0.8.1 or later recommended), which fetches discarded blocks   *\n"
+                    << "*   from peers. -txindex is not needed, and a pruned node cannot enable it.  *\n"
                     << "******************************************************************************\n\n"
                     << "Error response was:\n\n\t" << resp.errorMessage() << "\n\n";
+            if (++*failures >= 3) {
+                Error() << "Not checking again until Fulcrum restarts.";
+                disconnect(*connPtr2);
+            }
         };
         auto onFail = [] (RPC::Message::Id, const QString &errMsg) {
-            Warning() << "Unable to verify that BitcoinD is using txindex. Error: " << errMsg;
+            Warning() << "Unable to verify that BitcoinD can serve transactions by block hash. Error: " << errMsg;
         };
-        // ask bitcoind for tx #1 (first tx after genesis) to ensure it has txindex enabled.
-        bitcoindmgr->submitRequest(this, IdMixin::newId(), "getrawtransaction", {Util::ToHexFast(*optHash), false}, onSuccess, onError, onFail);
+        // ask bitcoind for tx #1 (first tx after genesis), naming its block
+        bitcoindmgr->submitRequest(this, IdMixin::newId(), "getrawtransaction", {Util::ToHexFast(*optHash), false, blockHashHex}, onSuccess, onError, onFail);
     }, Qt::QueuedConnection);
 
     {
