+    /// Electrum protocol 1.8, from the draft "Electrum protocol: variable-length block headers": the client reads each
+    /// header's length from bit 31 of its version field (80 or 164 bytes) and knows a v2 header's block is identified
+    /// by its BLAKE2b hash. Offered to clients on every chain, beside 1.4 to MaxProtocolVersion; there is no 1.7, whose
+    /// changes are not implemented. MaxProtocolVersion is left at 1.6 because PeerMgr judges other servers by it, and
+    /// this server neither peers nor announces itself as a 1.8 server.
+    inline constexpr Version ProtocolVersionHeaderLengths{1, 8, 0};
+
+    /// The protocol version to agree with a client that sent `server.version` with `clientMax` alone (`clientMin`
+    /// empty) or the range [`clientMin`, `clientMax`]. Returns an invalid Version to refuse.
+    ///
+    /// Supported: MinProtocolVersion to MaxProtocolVersion, and ProtocolVersionHeaderLengths. A single version is
+    /// accepted if it is one of those. A range gets the highest supported version within it: 1.8 if it reaches 1.8,
+    /// else the lower of its top and 1.6; refused if that is below the range's bottom (or below 1.4).
+    Version NegotiateProtocol(std::optional<Version> clientMin, const Version &clientMax);
+
+    /// Whether `blockchain.block.headers` answers with a list of hex headers rather than one concatenated hex string:
+    /// a list from 1.6 (as Fulcrum has since 1.6), and the concatenated string again at 1.8. A 1.8 client reads
+    /// either; Electrs Pruned, which speaks 1.8 on the BLAKE2b chain, sends the string, so a tool written against it
+    /// gets the same reply here.
+    constexpr bool HeadersAsList(const Version &protocolVersion) noexcept {
+        return protocolVersion >= Version{1, 6, 0} && protocolVersion < ProtocolVersionHeaderLengths;
+    }
+
     extern const QString AppVersion,  ///< in string form suitable for sending in protocol or banner e.g. "2.0"
                          AppSubVersion; ///< e.g. "Fulcrum 2.0"
 
