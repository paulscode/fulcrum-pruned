 namespace ServerMisc
 {
     const QString AppVersion(VERSION);
@@ -9,4 +11,22 @@ namespace ServerMisc
     // cannot tell the two apart has no way to know which rules the data it is given came from. Kept out of
     // VERSION so that macro stays equal to upstream's and release merges do not conflict on it.
     const QString AppSubVersion = QString("%1 %2+blake2b").arg(APPNAME, VERSION);
+
+    Version NegotiateProtocol(std::optional<Version> clientMin, const Version &clientMax)
+    {
+        const auto supported = [](const Version &v) {
+            return (v >= MinProtocolVersion && v <= MaxProtocolVersion) || v == ProtocolVersionHeaderLengths;
+        };
+        if (!clientMax.isValid())
+            return Version();
+        if (!clientMin)
+            return supported(clientMax) ? clientMax : Version();
+        if (!clientMin->isValid() || *clientMin > clientMax)
+            return Version();
+        const Version pick = clientMax >= ProtocolVersionHeaderLengths ? ProtocolVersionHeaderLengths
+                                                                       : std::min(clientMax, MaxProtocolVersion);
+        if (pick < std::max(*clientMin, MinProtocolVersion))
+            return Version();
+        return pick;
+    }
 }
