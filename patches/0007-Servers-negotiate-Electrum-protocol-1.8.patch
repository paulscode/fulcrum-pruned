+#include "ServerMisc.h"
+#include "Tests.h"
+#include "Version.h"
+
+#include <QString>
+
+#include <optional>
+
+namespace {
+
+/// The negotiated version as a string, "refused" for an invalid one. `min` empty means a single version was sent.
+QString negotiate(const char *min, const char *max) {
+    const std::optional<Version> clientMin = min ? std::optional<Version>(Version(QString(min))) : std::nullopt;
+    const Version v = ServerMisc::NegotiateProtocol(clientMin, Version(QString(max)));
+    return v.isValid() ? v.toString() : QStringLiteral("refused");
+}
+
+} // namespace
+
+TEST_SUITE(protocol)
+
+TEST_CASE(single_version) {
+    // 1.4 to 1.6 as before, and exactly 1.8; no 1.7, nothing above 1.8
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.3"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.4"), QString("1.4"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.4.2"), QString("1.4.2"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.5"), QString("1.5"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.6"), QString("1.6"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.7"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.8"), QString("1.8"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.8.0"), QString("1.8"));     // answered as "1.8"
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.8.1"), QString("refused")); // exactly 1.8
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.5.9"), QString("1.5.9"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.6.1"), QString("refused")); // above 1.6.0, as before
+    TEST_CHECK_EQUAL(negotiate(nullptr, "1.9"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate(nullptr, "garbage"), QString("refused"));
+};
+
+TEST_CASE(version_range) {
+    // the highest supported version within the range
+    TEST_CHECK_EQUAL(negotiate("1.3", "1.4.2"), QString("1.4.2"));
+    TEST_CHECK_EQUAL(negotiate("1.4", "1.6"), QString("1.6"));   // unchanged from before 1.8
+    TEST_CHECK_EQUAL(negotiate("1.4", "1.7"), QString("1.6"));   // 1.7 is not offered
+    TEST_CHECK_EQUAL(negotiate("1.3", "1.8"), QString("1.8"));
+    TEST_CHECK_EQUAL(negotiate("1.7", "1.8"), QString("1.8"));
+    TEST_CHECK_EQUAL(negotiate("1.4", "2.0"), QString("1.8"));
+    TEST_CHECK_EQUAL(negotiate("1.7", "1.7"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate("1.9", "2.0"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate("1.0", "1.3"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate("1.8", "1.4"), QString("refused")); // reversed
+    TEST_CHECK_EQUAL(negotiate("1.4", "1.8.1"), QString("1.8"));   // a range reaching 1.8 gets 1.8
+    TEST_CHECK_EQUAL(negotiate("1.4", "1.6.1"), QString("1.6"));
+    TEST_CHECK_EQUAL(negotiate("1.8", "1.8"), QString("1.8"));
+    TEST_CHECK_EQUAL(negotiate("1.8.1", "2.0"), QString("refused"));
+    TEST_CHECK_EQUAL(negotiate("1.6.1", "1.7"), QString("refused"));
+};
+
+TEST_CASE(headers_reply_form) {
+    // blockchain.block.headers: a concatenated hex string below 1.6 and at 1.8, a list from 1.6 to below 1.8
+    TEST_CHECK(!ServerMisc::HeadersAsList(Version{1, 4, 0}));
+    TEST_CHECK(!ServerMisc::HeadersAsList(Version{1, 4, 2}));
+    TEST_CHECK(!ServerMisc::HeadersAsList(Version{1, 5, 0}));
+    TEST_CHECK(ServerMisc::HeadersAsList(Version{1, 6, 0}));
+    TEST_CHECK(!ServerMisc::HeadersAsList(Version{1, 8, 0}));
+};
+
+TEST_SUITE_END()
