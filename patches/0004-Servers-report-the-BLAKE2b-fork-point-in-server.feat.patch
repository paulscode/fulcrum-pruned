diff --git a/src/Storage.cpp b/src/Storage.cpp
index 53e01c8..f8a24f6 100644
--- a/src/Storage.cpp
+++ b/src/Storage.cpp
@@ -2822,6 +2822,33 @@ void Storage::deleteHeadersPastHeight(rocksdb::WriteBatch &batch, BlockHeight he
         throw InternalError("header truncate resulted in an unexepected value");
 }
 
+auto Storage::blake2bForkPoint() const -> std::optional<std::pair<BlockHeight, HeaderHash>>
+{
+    Header tipHeader;
+    const int tipHeight = latestTip(&tipHeader).first;
+    if (tipHeight < 0 || !BTC::IsHeaderV2(tipHeader))
+        return std::nullopt; // no extended header in this chain, or not yet
+    const auto hashAt = [this](BlockHeight h) -> std::optional<HeaderHash> {
+        if (const auto hdr = headerForHeight(h)) return BTC::HeaderHashRev(*hdr);
+        return std::nullopt;
+    };
+    {
+        std::unique_lock g(forkPointMut);
+        if (forkPointCache && int(forkPointCache->first) <= tipHeight && hashAt(forkPointCache->first) == forkPointCache->second)
+            return forkPointCache;
+    }
+    const auto height = BTC::FindFirstV2Height(unsigned(tipHeight), [this](unsigned h) -> std::optional<bool> {
+        if (const auto hdr = headerForHeight(h)) return BTC::IsHeaderV2(*hdr);
+        return std::nullopt;
+    });
+    if (!height) return std::nullopt;
+    const auto hash = hashAt(*height);
+    if (!hash) return std::nullopt;
+    std::unique_lock g(forkPointMut);
+    forkPointCache.emplace(*height, *hash);
+    return forkPointCache;
+}
+
 auto Storage::headerForHeight(BlockHeight height, QString *err, HeaderHash *hashOut) const -> std::optional<Header>
 {
     std::optional<Header> ret;
diff --git a/src/Storage.h b/src/Storage.h
index b8983f5..f0bf89a 100644
--- a/src/Storage.h
+++ b/src/Storage.h
@@ -133,6 +133,12 @@ public:
     /// Convenience. Given a block height, return the block hash.
     std::optional<HeaderHash> hashForHeight(BlockHeight height, QString *err = nullptr) const;
 
+    /// Where this chain switched to extended (BLAKE2b) headers: the height of the first one and its block hash (reversed,
+    /// as bitcoind renders it). nullopt on a chain with no extended header, or one whose tip has not reached it yet.
+    /// Thread safe. Found by binary search over the stored headers the first time, then cached; a cached answer is
+    /// re-checked against the stored header on each call, so a reorg across the fork point cannot leave it stale.
+    std::optional<std::pair<BlockHeight, HeaderHash>> blake2bForkPoint() const;
+
     /// Implicitly takes a lock to return this. Thread safe. Breakdown of info returned:
     ///   .first - the latest valid height we have synched or -1 if no headers.
     ///   .second - the latest valid chainTip 32-byte sha256 double hash of the header (the chainTip as it's called in
@@ -498,6 +504,9 @@ protected:
     bool isRpaNeedsFullCheck() const;
 
 private:
+    mutable std::mutex forkPointMut; ///< guards forkPointCache
+    mutable std::optional<std::pair<BlockHeight, HeaderHash>> forkPointCache; ///< see blake2bForkPoint()
+
     const std::shared_ptr<const Options> options;
     const std::unique_ptr<ScriptHashSubsMgr> subsmgr;
     const std::unique_ptr<DSProofSubsMgr> dspsubsmgr;
diff --git a/src/tests/BlockHeader_tests.cpp b/src/tests/BlockHeader_tests.cpp
index a8ac403..ccea911 100644
--- a/src/tests/BlockHeader_tests.cpp
+++ b/src/tests/BlockHeader_tests.cpp
@@ -207,4 +207,31 @@ TEST_CASE(header_hash_dispatch) {
     Log() << "HeaderHash dispatches on the header, and refuses one flagged extended that is not";
 };
 
+TEST_CASE(fork_point_search) {
+    // BTC::FindFirstV2Height backs server.features' blake2b_fork. A chain is modelled by its activation height:
+    // headers below it are legacy, headers from it on are extended.
+    unsigned reads = 0;
+    const auto chain = [&reads](std::optional<unsigned> activation) {
+        return [&reads, activation](unsigned h) -> std::optional<bool> { ++reads; return activation && h >= *activation; };
+    };
+    // the BLAKE2b mainnet split, read at a recent tip, in about log2(tip) reads rather than a scan
+    reads = 0;
+    TEST_CHECK(BTC::FindFirstV2Height(981133, chain(961640u)) == std::optional<unsigned>(961640));
+    TEST_CHECK(reads <= 22);
+    // the SHA256 chain, and a BLAKE2b chain still below activation: no fork point
+    TEST_CHECK(!BTC::FindFirstV2Height(981133, chain(std::nullopt)));
+    TEST_CHECK(!BTC::FindFirstV2Height(961639, chain(961640u)));
+    // edges: activation exactly at the tip, at height 1, and a chain extended from genesis
+    TEST_CHECK(BTC::FindFirstV2Height(961640, chain(961640u)) == std::optional<unsigned>(961640));
+    TEST_CHECK(BTC::FindFirstV2Height(200, chain(1u)) == std::optional<unsigned>(1));
+    TEST_CHECK(BTC::FindFirstV2Height(0, chain(0u)) == std::optional<unsigned>(0));
+    // a regtest activation height, which nothing may assume
+    TEST_CHECK(BTC::FindFirstV2Height(25, chain(10u)) == std::optional<unsigned>(10));
+    // an unreadable header gives no answer rather than a wrong one
+    // the first probe is the midpoint
+    const auto unreadable = [](unsigned h) -> std::optional<bool> { if (h == 981133 / 2) return std::nullopt; return h >= 961640; };
+    TEST_CHECK(!BTC::FindFirstV2Height(981133, unreadable));
+    Log() << "FindFirstV2Height finds the first extended header by binary search";
+};
+
 TEST_SUITE_END()
