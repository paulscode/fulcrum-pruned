 src/BTC.h                       |  9 +++++++++
 src/Servers.cpp                 | 21 ++++++++++++++++-----
 src/Storage.cpp                 | 27 +++++++++++++++++++++++++++
 src/Storage.h                   |  9 +++++++++
 src/tests/BlockHeader_tests.cpp | 27 +++++++++++++++++++++++++++
 6 files changed, 103 insertions(+), 5 deletions(-)

diff --git a/src/BTC.cpp b/src/BTC.cpp
index 1c8b2c4..06c6f38 100644
--- a/src/BTC.cpp
+++ b/src/BTC.cpp
@@ -108,6 +108,21 @@ namespace BTC
         return QByteArray(reinterpret_cast<const char *>(hash.begin()), int(hash.size()));
     }
 
+    std::optional<unsigned> FindFirstV2Height(unsigned tip, const std::function<std::optional<bool>(unsigned)> &isV2At)
+    {
+        const auto tipIsV2 = isV2At(tip);
+        if (!tipIsV2 || !*tipIsV2) return std::nullopt;
+        unsigned lo = 0, hi = tip; // invariant: the header at hi is extended; the first extended one is in [lo, hi]
+        while (lo < hi) {
+            const unsigned mid = lo + (hi - lo) / 2;
+            const auto midIsV2 = isV2At(mid);
+            if (!midIsV2) return std::nullopt;
+            if (*midIsV2) hi = mid;
+            else lo = mid + 1;
+        }
+        return lo;
+    }
+
     QByteArray HeaderHashRev(const QByteArray &hdr)
     {
         if (!IsHeaderV2(hdr))
