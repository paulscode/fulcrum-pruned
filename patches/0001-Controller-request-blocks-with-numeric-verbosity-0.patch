From 0ba0b420e1b234c49555787cdf4467565774794d Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Sun, 8 Nov 2026 14:32:57 -0600
Subject: [PATCH 1/5] Controller: request blocks with numeric verbosity 0

getblock <hash> false and getblock <hash> 0 mean the same to bitcoind,
but btc-rpc-proxy, which a pruned node puts in front of its RPC port to
serve blocks it has discarded, intercepts only a numeric verbosity. A
boolean falls through its match to bitcoind, which answers "Block not
available (pruned data)" for every block below the prune height, so
Fulcrum could not index a pruned node's history at all.

Checked in every proxy tag from v0.5.1 to v0.8.2-blake2b.2. Harmless
against an archival node.
---
 src/Controller.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/Controller.cpp b/src/Controller.cpp
index 3f14d39..ebf75d8 100644
--- a/src/Controller.cpp
+++ b/src/Controller.cpp
@@ -573,7 +573,11 @@ void DownloadBlocksTask::do_get(unsigned int bnum)
         QVariant var = resp.result();
         const auto hash = Util::ParseHexFast(var.toByteArray());
         if (hash.length() == HashLen) {
-            submitRequest("getblock", {var, false}, [this, bnum, hash](const RPC::Message & resp){
+            // Verbosity as the number 0, not the boolean false. bitcoind takes either, but btc-rpc-proxy
+            // (which serves a pruned node's discarded blocks by fetching them from peers) only intercepts
+            // a numeric verbosity and passes `false` through to bitcoind, which then fails it for any block
+            // below the prune height.
+            submitRequest("getblock", {var, 0}, [this, bnum, hash](const RPC::Message & resp){
                 try {
                     auto rawblock = Util::ParseHexFast(resp.result().toByteArray());
                     // header size depends on whether this is a legacy or an extended (BLAKE2b) header
