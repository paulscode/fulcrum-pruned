+        // default fail function just sends json rpc error "internal error: <message>", after the caller's onFail
+        onFail ? ThreadPool::FailFunc([onFail, fail = defaultTPFailFunc(c, batchId, reqId)](const QString &what) {
+                     onFail();
+                     fail(what);
+                 })
+               : defaultTPFailFunc(c, batchId, reqId),
         // lower is sooner, higher is later. Default 0.
         priority
