@@ -889,6 +894,30 @@ void ServerBase::generic_async_to_bitcoind(Client *c, const RPC::BatchId batchId
         }
     }
     // /Throttling support
+}
+
+void ServerBase::bdThrottleUncount(Client *c)
+{
+    c->bdReqCtr -= std::min(c->bdReqCtr, 1LL); // decrease throttle counter (per-client, owned by this thread)
+    --c->perIPData->bdReqCtr; // decrease bitcoind request counter (per-IP, owned by multiple threads)
+}
+
+void ServerBase::generic_async_to_bitcoind(Client *c, const RPC::BatchId batchId, const RPC::Message::Id & reqId,
+                                           const QString &method,
+                                           const QVariantList & params,
+                                           const BitcoinDSuccessFunc & successFunc,
+                                           const BitcoinDErrorFunc & errorFunc,
+                                           std::optional<int> useCacheIfNotOlderThan,
+                                           bool alreadyCounted,
+                                           int timeoutMS)
+{
+    if (QThread::currentThread() != c->thread()) [[unlikely]] {
+        // Paranoia, in case I or a future programmer forgets this rule.
+        Warning() << __func__ << " is meant to be called from the Client thread only. The current thread is not the"
+                  << " Client thread. This may cause problems if the Client is deleted while submitting the request. FIXME!";
+    }
+    if (!alreadyCounted)
+        bdThrottleCount(c);
     bitcoindmgr->submitRequest(c, newId(), method, params,
         // success
         [c, batchId, reqId, successFunc](const RPC::Message & reply) {
@@ -934,7 +963,7 @@ void ServerBase::generic_async_to_bitcoind(Client *c, const RPC::BatchId batchId
         // use default function on failure, sends json rpc error "internal error: <message>"
         defaultBDFailFunc(c, batchId, reqId),
         // timeout
-        BitcoinDMgr::kDefaultTimeoutMS,
+        timeoutMS > 0 ? timeoutMS : BitcoinDMgr::kDefaultTimeoutMS,
         // optional response caching control
         useCacheIfNotOlderThan
     );
@@ -2279,18 +2308,102 @@ void Server::rpc_blockchain_transaction_get(Client *c, const RPC::BatchId batchI
             throw RPCError("Invalid verbose argument; expected boolean");
         verbose = verbArg;
     }
-    generic_async_to_bitcoind(c, batchId, m.id, "getrawtransaction", QVariantList{ Util::ToHexFast(txHash), verbose },
-        // use the default success func, which just echoes the bitcoind reply to the client
-        BitcoinDSuccessFunc(),
-        // error func, throw an RPCError
-        [](const RPC::Message & errResponse) {
-            // EX does this weird thing.. we do it too for now until we can verify not doing it won't break old EC
-            // clients... TODO: see if this can be removed in favor of a more canonical error message.
-            throw RPCError(formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(errResponse),
-                           RPC::Code_App_DaemonError);
-        }
+    if (!bitcoindmgr->getRpcSupportInfo().getRawTransactionTakesBlockHash) {
+        // A node that takes no block hash finds a confirmed transaction only with -txindex: ask as always.
+        generic_async_to_bitcoind(c, batchId, m.id, "getrawtransaction", QVariantList{ Util::ToHexFast(txHash), verbose },
+            // use the default success func, which just echoes the bitcoind reply to the client
+            BitcoinDSuccessFunc(),
+            // error func, throw an RPCError
+            [](const RPC::Message & errResponse) {
+                // EX does this weird thing.. we do it too for now until we can verify not doing it won't break old EC
+                // clients... TODO: see if this can be removed in favor of a more canonical error message.
+                throw RPCError(formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(errResponse),
+                               RPC::Code_App_DaemonError);
+            }
+        );
+        return; // <-- do nothing right now. Will respond when daemon calls us back in callbacks above.
+    }
+    // Find the block holding this transaction in our own index, and hand its hash to bitcoind. Without a block hash,
+    // bitcoind can find a confirmed transaction only with -txindex, which a pruned node cannot have. With one, it needs
+    // only the block, which a proxy such as btc-rpc-proxy (v0.8.0 and later) fetches from peers when the node has
+    // pruned it. A transaction we have not indexed (unconfirmed, or unknown) is asked for without a hash, which still
+    // finds a mempool transaction.
+    //
+    // The bitcoind request is counted against the client's throttle here, on the client thread, as the request is
+    // read. Counted only when it reached bitcoind, after the lookup on the thread pool, a client could pipeline tens of
+    // thousands of them (each a block fetched from peers, on a pruned node) before the pause took effect.
+    bdThrottleCount(c);
+    struct Lookup { QByteArray blockHashHex; QString error; };
+    generic_do_async(c, batchId, m.id,
+        // runs in a worker thread: the lookup reads the database. Never throws, so the completion (or, if the pool
+        // refuses the job, onFail below) always undoes the count above.
+        [txHash, this] {
+            Lookup ret;
+            try {
+                if (const auto optPair = storage->getConfirmedTxBlockHeightAndHeader(txHash))
+                    ret.blockHashHex = Util::ToHexFast(BTC::HeaderHashRev(optPair->second)); // BLAKE2b-aware block id
+            } catch (const std::exception &e) {
+                ret.error = QString("internal error: %1").arg(e.what());
+            }
+            return ret;
+        },
+        // runs in the client thread, only if the client is still alive
+        [c, batchId, mId = m.id, txHash, verbose, this](const Lookup &lookup) {
+            if (!lookup.error.isEmpty()) {
+                bdThrottleUncount(c);
+                emit c->sendError(false, RPC::Code_InternalError, lookup.error, batchId, mId);
+                return;
+            }
+            const auto &blockHashHex = lookup.blockHashHex;
+            QVariantList params{ Util::ToHexFast(txHash), verbose };
+            if (!blockHashHex.isEmpty())
+                params.push_back(blockHashHex);
+            generic_async_to_bitcoind(c, batchId, mId, "getrawtransaction", params,
+                // Echo bitcoind's reply to the client, once it is the transaction asked for. With a block hash, the
+                // answer can come from a block fetched from peers through a proxy; never relay a different one.
+                [txHash, verbose, segwit = isBTC() || isLTC(), mweb = isLTC(), tokens = !isNonBCH()]
+                (const RPC::Message &reply) -> BitcoinDSuccessFuncResult {
+                    const QVariant result = reply.result();
+                    QString got;
+                    if (verbose)
+                        got = result.toMap().value("txid").toString();
+                    else {
+                        try {
+                            bitcoin::CMutableTransaction tx;
+                            BTC::Deserialize(tx, Util::ParseHexFast(result.toString().toLatin1()), 0, segwit, mweb, tokens);
+                            got = QString::fromStdString(tx.GetHash().ToString());
+                        } catch (const std::exception &) {}
+                    }
+                    if (got.compare(QString::fromLatin1(Util::ToHexFast(txHash)), Qt::CaseInsensitive) != 0)
+                        throw RPCError("The node answered with a different transaction than the one requested",
+                                       RPC::Code_App_DaemonError);
+                    return result;
+                },
+                // error func, throw an RPCError
+                [hadBlockHash = !blockHashHex.isEmpty()](const RPC::Message & errResponse) {
+                    // EX does this weird thing.. we do it too for now until we can verify not doing it won't break old EC
+                    // clients... TODO: see if this can be removed in favor of a more canonical error message.
+                    if (!hadBlockHash && isBitcoinDNoTxIndexAdvice(errResponse))
+                        throw RPCError(formatBitcoinDErrorToLookLikeDumbElectrumXPythonRepr(errResponse.errorCode(),
+                                           "No such mempool or blockchain transaction. It is not in the index of this server:"
+                                           " it is unconfirmed and no longer in the mempool, on another chain, or in a"
+                                           " block this server has not indexed yet."),
+                                       RPC::Code_App_DaemonError);
+                    throw RPCError(formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(errResponse),
+                                   RPC::Code_App_DaemonError);
+                },
+                std::nullopt, /* alreadyCounted = */ true,
+                // With a block hash, a block the node has pruned is fetched from peers through the proxy, which
+                // can take far longer than the 15 s client requests get (over Tor especially), so allow what the
+                // operator configured for the node (bitcoind_timeout). A mempool lookup keeps the default.
+                blockHashHex.isEmpty() ? 0 : options->bdTimeoutMS
+            );
+        },
+        0, // priority
+        // the pool refused the job, so neither of the above runs: undo the count
+        [c] { bdThrottleUncount(c); }
     );
-    // <-- do nothing right now, return without replying. Will respond when daemon calls us back in callbacks above.
+    // <-- do nothing right now, return without replying. Will respond when the callbacks above complete.
 }
