@@ -843,26 +854,20 @@ void ServerBase::generic_do_async(Client *c, RPC::BatchId batchId, const RPC::Me
                 emit c->sendError(false, RPC::ErrorCodes::Code_InternalError, e.what(), batchId, reqId);
