                                    const BitcoinDSuccessFunc & successFunc,
                                    const BitcoinDErrorFunc & errorFunc = BitcoinDErrorFunc(),
-                                   std::optional<int> useCacheIfNotOlderThan = std::nullopt);
+                                   std::optional<int> useCacheIfNotOlderThan = std::nullopt,
+                                   bool alreadyCounted = false, ///< true if the caller already called bdThrottleCount for this request
+                                   int timeoutMS = 0); ///< 0: BitcoinDMgr::kDefaultTimeoutMS
+
+    /// Counts one bitcoind request against the client's throttle, pausing reads from it at the hi-water mark.
+    /// generic_async_to_bitcoind does this itself; a handler that does other work first (on a thread pool) calls it
+    /// up front, on the client thread, so the count is taken as the request is read, which is what makes the pause
+    /// bite, and then passes alreadyCounted. bdThrottleUncount undoes it for a request that never reaches bitcoind.
+    void bdThrottleCount(Client *c);
+    static void bdThrottleUncount(Client *c);
 
     /// Subclasses may set this pointer if they wish the generic_do_async function above to use a private/custom
     /// threadpool. Otherwise the app-global ::AppThreadPool()  will be used for generic_do_async().
