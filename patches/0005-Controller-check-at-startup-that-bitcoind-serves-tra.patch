From 2b6118970c84b9595b0ce7d447e797885a7167c8 Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Sun, 8 Nov 2026 14:36:21 -0600
Subject: [PATCH 5/6] Controller: check at startup that bitcoind serves
 transactions by block hash

The startup check asks for tx #1 with getrawtransaction and no block
hash, and on failure tells the user to enable -txindex. With
blockchain.transaction.get naming the block, a node that takes a block
hash (getRawTransactionTakesBlockHash) needs no -txindex, and a pruned
one cannot enable it anyway.

For such a node, ask the way transaction.get now asks: tx #1 with the
hash of its block, taken from our own headers. Block 1 is long gone from
a pruned node, so this exercises the pruned path end to end. On failure,
say what is actually needed: on a pruned node, a proxy in front of its
RPC port that fetches discarded blocks from peers, such as btc-rpc-proxy
v0.8.0 or later. Three failures (a timeout counts) and it stops asking
until restart, rather than a fetch from peers and the banner on every
block. It uses bitcoind_timeout, since block 1 may come from peers.

Any other node is asked exactly as before, with the same banner.

The block hash comes from BTC::HeaderHashRev, so a block past the
BLAKE2b fork is named by its BLAKE2b id.
---
 src/Controller.cpp | 75 ++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 62 insertions(+), 13 deletions(-)

diff --git a/src/Controller.cpp b/src/Controller.cpp
index c510d52..5eebbbd 100644
--- a/src/Controller.cpp
+++ b/src/Controller.cpp
@@ -213,15 +213,31 @@ void Controller::startup()
         }
     }, Qt::QueuedConnection);
 
-    // Checks if the remote bitcoind has -txindex or can serve arbitrary transactions. Called initially when upToDate()
-    // is first emitted, and disconnects itself from upToDate if we did in fact detect that bitcoind can serve arbitrary
-    // tx's. If there is an error retrieving tx #1, it will warn the user to enable txindex.
+    // Checks that the remote bitcoind can serve a confirmed transaction the way blockchain.transaction.get will ask
+    // for one. Called initially when upToDate() is first emitted, and disconnects itself from upToDate if we did in
+    // fact detect that bitcoind can serve it.
+    //
+    // A node that takes a block hash in getrawtransaction (see RpcSupportInfo) is asked for tx #1 with the hash of
+    // its block, taken from our own index: that needs no -txindex, and on a pruned node it goes through a proxy that
+    // fetches the block from peers. Block 1 is long gone from a pruned node, so a node whose RPC cannot serve its
+    // discarded blocks is caught here, at startup, rather than by the first wallet that looks a transaction up.
+    // Any other node is asked without a hash, which needs -txindex. If there is an error retrieving tx #1, it will warn
+    // the user to enable txindex.
     // Assumption: tx #1 is not a bitcoind wallet tx. (If it is, then we will get a possible false positive here).
     auto connPtr2 = std::make_shared<QMetaObject::Connection>();
-    *connPtr2 = connect(this, &Controller::upToDate, this, [this, connPtr2] {
+    auto failures = std::make_shared<int>(0);
+    *connPtr2 = connect(this, &Controller::upToDate, this, [this, connPtr2, failures] {
         const auto optHash = storage->hashForTxNum(1, false, nullptr, true); // skip cache, read from txNum2txHash file to get first non-genesis tx hash
         if (!optHash) return; // no blocks yet, somehow. must be a brand new chain. we will be called again later when blocks start showing up.
-        auto onSuccess = [this, connPtr2, hash=*optHash] (const RPC::Message &resp) {
+        const bool byBlockHash = bitcoindmgr->getRpcSupportInfo().getRawTransactionTakesBlockHash;
+        QVariantList params{Util::ToHexFast(*optHash), false};
+        if (byBlockHash) {
+            const auto optHeight = storage->heightForTxNum(1);
+            const auto optHeader = optHeight ? storage->headerForHeight(*optHeight) : std::nullopt;
+            if (!optHeader) return; // not expected once tx #1 is indexed; try again on the next upToDate()
+            params.push_back(Util::ToHexFast(BTC::HeaderHashRev(*optHeader))); // BLAKE2b-aware block id
+        }
+        auto onSuccess = [this, connPtr2, byBlockHash, hash=*optHash] (const RPC::Message &resp) {
             bitcoin::CMutableTransaction tx;
             constexpr auto kErrLine2 = "Something is wrong with either BitcoinD or our ability to understand its RPC responses.";
             try {
@@ -236,23 +252,56 @@ void Controller::startup()
                 Error() << kErrLine2;
                 return;
             }
-            DebugM("BitcoinD verified to have txindex enabled");
+            if (byBlockHash)
+                DebugM("BitcoinD verified to serve indexed transactions by block hash");
+            else
+                DebugM("BitcoinD verified to have txindex enabled");
             // success! disconnect the slot now, connPtr2 will delete the managed object when we return.
             disconnect(*connPtr2);
         };
-        auto onError = [] (const RPC::Message &resp) {
+        // By block hash, this is asked again at each upToDate (each new block) until it succeeds, but not forever: on a
+        // node that cannot serve it, that is a fetch from peers and this banner on every block. Three tries, then it
+        // says so and stops.
+        auto onError = [this, connPtr2, failures, byBlockHash] (const RPC::Message &resp) {
+            if (!byBlockHash) {
+                Error() << "\n"
+                        << "******************************************************************************\n"
+                        << "*   Error: txindex verification failed!                                      *\n"
+                        << "*   Please ensure that your BitcoinD node has txindex enabled (-txindex=1)   *\n"
+                        << "******************************************************************************\n\n"
+                        << "Error response was:\n\n\t" << resp.errorMessage() << "\n\n";
+                return;
+            }
             Error() << "\n"
                     << "******************************************************************************\n"
-                    << "*   Error: txindex verification failed!                                      *\n"
-                    << "*   Please ensure that your BitcoinD node has txindex enabled (-txindex=1)   *\n"
+                    << "*   Error: BitcoinD could not serve transaction #1 by its block hash!        *\n"
+                    << "*   Wallets will not be able to look up confirmed transactions.              *\n"
+                    << "*   On a pruned node, the RPC port must be served by a proxy that fetches    *\n"
+                    << "*   discarded blocks from peers, such as btc-rpc-proxy v0.8.0 or later.      *\n"
+                    << "*   -txindex is not needed (and a pruned node cannot enable it).             *\n"
                     << "******************************************************************************\n\n"
                     << "Error response was:\n\n\t" << resp.errorMessage() << "\n\n";
+            if (++*failures >= 3) {
+                Error() << "Not checking again until " APPNAME " restarts.";
+                disconnect(*connPtr2);
+            }
         };
-        auto onFail = [] (RPC::Message::Id, const QString &errMsg) {
-            Warning() << "Unable to verify that BitcoinD is using txindex. Error: " << errMsg;
+        auto onFail = [this, connPtr2, failures, byBlockHash] (RPC::Message::Id, const QString &errMsg) {
+            if (!byBlockHash) {
+                Warning() << "Unable to verify that BitcoinD is using txindex. Error: " << errMsg;
+                return;
+            }
+            Warning() << "Unable to verify that BitcoinD can serve transactions by block hash. Error: " << errMsg;
+            // A timeout counts too: a proxy too slow to answer would otherwise be asked again on every block.
+            if (++*failures >= 3) {
+                Warning() << "Not checking again until " APPNAME " restarts.";
+                disconnect(*connPtr2);
+            }
         };
-        // ask bitcoind for tx #1 (first tx after genesis) to ensure it has txindex enabled.
-        bitcoindmgr->submitRequest(this, IdMixin::newId(), "getrawtransaction", {Util::ToHexFast(*optHash), false}, onSuccess, onError, onFail);
+        // ask bitcoind for tx #1 (first tx after genesis). By block hash, block 1 comes from peers on a pruned node,
+        // which can take longer than the default timeout, so allow what the operator configured (bitcoind_timeout).
+        bitcoindmgr->submitRequest(this, IdMixin::newId(), "getrawtransaction", params, onSuccess, onError, onFail,
+                                   byBlockHash ? options->bdTimeoutMS : BitcoinDMgr::kDefaultTimeoutMS);
     }, Qt::QueuedConnection);
 
     {
