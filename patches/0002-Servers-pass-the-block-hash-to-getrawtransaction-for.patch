From 4e7b1f89ec4440f7faa0f10b0f0dd810ac8ca68a Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Sun, 8 Nov 2026 14:35:35 -0600
Subject: [PATCH 2/5] Servers: pass the block hash to getrawtransaction for an
 indexed transaction

blockchain.transaction.get forwarded getrawtransaction <txid> <verbose>
with no block hash. For a confirmed transaction bitcoind can answer that
only with -txindex, and a pruned node cannot have -txindex (Core and Knots
refuse the combination), so every confirmed lookup failed against one.

Fulcrum already knows where each transaction is: txhash2txnum gives its
height, and the header gives the block hash, the lookup behind
blockchain.transaction.get_confirmed_blockhash. Do that lookup in a worker
thread, then pass the hash. bitcoind then needs only the block, which
btc-rpc-proxy fetches from peers when the node has pruned it (proxy
v0.8.0 and later). The hash comes from BTC::HeaderHashRev, so a BLAKE2b
block is named by its BLAKE2b id.

A transaction not in the index (unconfirmed, or unknown) is still asked
for without a hash, which finds it in the mempool. When that fails, the
node answers -5 with advice to enable -txindex; replace the message with
one that says the transaction is not in this server's index, keeping the
code and the ElectrumX-style formatting.
---
 src/Servers.cpp | 59 +++++++++++++++++++++++++++++++++++++++----------
 1 file changed, 47 insertions(+), 12 deletions(-)

diff --git a/src/Servers.cpp b/src/Servers.cpp
index 7e55386..9da5449 100644
--- a/src/Servers.cpp
+++ b/src/Servers.cpp
@@ -327,7 +327,7 @@ namespace {
         return ret;
     }
 
-    QString formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(const RPC::Message &errResponse){
+    QString formatBitcoinDErrorToLookLikeDumbElectrumXPythonRepr(const int code, const QString &message) {
         constexpr auto escapeSingleQuote = [](const QString &s) -> QString {
             const QByteArray b = s.toUtf8();
             QByteArray ret;
@@ -346,7 +346,18 @@ namespace {
             return QString::fromUtf8(ret);
         };
         return QStringLiteral("daemon error: DaemonError({'code': %1, 'message': '%2'})")
-                .arg(errResponse.errorCode()).arg(escapeSingleQuote(errResponse.errorMessage()));
+                .arg(code).arg(escapeSingleQuote(message));
+    }
+
+    QString formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(const RPC::Message &errResponse) {
+        return formatBitcoinDErrorToLookLikeDumbElectrumXPythonRepr(errResponse.errorCode(), errResponse.errorMessage());
+    }
+
+    /// bitcoind's answer to `getrawtransaction <txid>` (no block hash) for a txid it cannot find without -txindex:
+    /// RPC_INVALID_ADDRESS_OR_KEY with a message advising -txindex. Fulcrum only sends that form for a txid that is not
+    /// in its own index, so the advice is wrong here: on a pruned node -txindex cannot even be enabled.
+    bool isBitcoinDNoTxIndexAdvice(const RPC::Message &errResponse) {
+        return errResponse.errorCode() == -5 && errResponse.errorMessage().contains("txindex", Qt::CaseInsensitive);
     }
 
     /// used internally by RPC methods. Given a hashHex, ensure it's 32 bytes (or DataLen) of hash data and nothing else.
@@ -2279,18 +2290,42 @@ void Server::rpc_blockchain_transaction_get(Client *c, const RPC::BatchId batchI
             throw RPCError("Invalid verbose argument; expected boolean");
         verbose = verbArg;
     }
-    generic_async_to_bitcoind(c, batchId, m.id, "getrawtransaction", QVariantList{ Util::ToHexFast(txHash), verbose },
-        // use the default success func, which just echoes the bitcoind reply to the client
-        BitcoinDSuccessFunc(),
-        // error func, throw an RPCError
-        [](const RPC::Message & errResponse) {
-            // EX does this weird thing.. we do it too for now until we can verify not doing it won't break old EC
-            // clients... TODO: see if this can be removed in favor of a more canonical error message.
-            throw RPCError(formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(errResponse),
-                           RPC::Code_App_DaemonError);
+    // Find the block holding this transaction in our own index, and hand its hash to bitcoind. Without a block hash,
+    // bitcoind can find a confirmed transaction only with -txindex, which a pruned node cannot have. With one, it needs
+    // only the block, which btc-rpc-proxy fetches from peers when the node has pruned it. A transaction we have not
+    // indexed (unconfirmed, or unknown) is asked for without a hash, which still finds a mempool transaction.
+    generic_do_async(c, batchId, m.id,
+        // runs in a worker thread: the lookup reads the database
+        [txHash, this] {
+            QByteArray blockHashHex;
+            if (const auto optPair = storage->getConfirmedTxBlockHeightAndHeader(txHash))
+                blockHashHex = Util::ToHexFast(BTC::HeaderHashRev(optPair->second)); // BLAKE2b-aware block id
+            return blockHashHex;
+        },
+        // runs in the client thread, only if the client is still alive
+        [c, batchId, mId = m.id, txHash, verbose, this](const QByteArray &blockHashHex) {
+            QVariantList params{ Util::ToHexFast(txHash), verbose };
+            if (!blockHashHex.isEmpty())
+                params.push_back(blockHashHex);
+            generic_async_to_bitcoind(c, batchId, mId, "getrawtransaction", params,
+                // use the default success func, which just echoes the bitcoind reply to the client
+                BitcoinDSuccessFunc(),
+                // error func, throw an RPCError
+                [hadBlockHash = !blockHashHex.isEmpty()](const RPC::Message & errResponse) {
+                    // EX does this weird thing.. we do it too for now until we can verify not doing it won't break old EC
+                    // clients... TODO: see if this can be removed in favor of a more canonical error message.
+                    if (!hadBlockHash && isBitcoinDNoTxIndexAdvice(errResponse))
+                        throw RPCError(formatBitcoinDErrorToLookLikeDumbElectrumXPythonRepr(errResponse.errorCode(),
+                                           "No such mempool or blockchain transaction. It is not in the index of this server:"
+                                           " it is unconfirmed and no longer in the mempool, or it is not on this chain."),
+                                       RPC::Code_App_DaemonError);
+                    throw RPCError(formatBitcoinDErrorResponseToLookLikeDumbElectrumXPythonRepr(errResponse),
+                                   RPC::Code_App_DaemonError);
+                }
+            );
         }
     );
-    // <-- do nothing right now, return without replying. Will respond when daemon calls us back in callbacks above.
+    // <-- do nothing right now, return without replying. Will respond when the callbacks above complete.
 }
 void Server::rpc_blockchain_transaction_get_confirmed_blockhash(Client *c, const RPC::BatchId batchId, const RPC::Message &m)
 {
